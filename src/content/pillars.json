    "pt": "Sou eu.",
    "answer": "C'",
    "options": [
     "Ce ",
     "Ça ",
     "Il "
    ]
   },
   {
    "fr": "Ce ___est pas moi.",
    "pt": "Não sou eu.",
    "answer": "n'",
    "options": [
     "ne ",
     "pas ",
     "non "
    ]
   },
   {
    "fr": "___ai le temps.",
    "pt": "Eu tenho tempo.",
    "answer": "J'",
    "options": [
     "Je ",
     "Tu ",
     "Me "
    ]
   }
  ]
 },
 {
