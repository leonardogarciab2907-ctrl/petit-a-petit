[
 {
  "id": "p-pronomes",
  "title": "Pronomes pessoais",
  "trigger": [
   "je",
   "tu",
   "il",
   "elle",
   "on",
   "nous",
   "vous"
  ],
  "explanation": "Em francês o sujeito quase nunca some: sempre diga je, tu, il… je = eu, tu = você (informal), il / elle = ele / ela, on = a gente, nous = nós, vous = vocês ou você educado, ils / elles = eles / elas.",
  "examples": [
   {
    "fr": "Je suis là.",
    "pt": "Eu estou aqui."
   },
   {
    "fr": "Elle est là.",
    "pt": "Ela está aqui."
   }
  ],
  "practice": [
   {
    "fr": "___ suis là.",
    "pt": "Eu estou aqui.",
    "answer": "Je",
    "options": [
     "Tu",
     "Il",
     "Nous"
    ]
   },
   {
    "fr": "___ es là ?",
    "pt": "Você está aí?",
    "answer": "Tu",
    "options": [
     "Je",
     "Il",
     "Vous"
    ]
   },
   {
    "fr": "___ sommes là.",
    "pt": "Nós estamos aqui.",
    "answer": "Nous",
    "options": [
     "Vous",
     "Ils",
     "Je"
    ]
   },
   {
    "fr": "___ êtes là ?",
    "pt": "Vocês estão aí?",
    "answer": "Vous",
    "options": [
     "Nous",
     "Tu",
     "Ils"
    ]
   }
  ]
 },
