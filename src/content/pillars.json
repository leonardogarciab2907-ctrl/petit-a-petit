 {
  "id": "p-elisao",
  "title": "Elisão: j', l', c', n'",
  "trigger": [
   "ce",
   "je",
   "le",
   "ne",
   "de",
   "que",
   "me",
   "te",
   "se"
  ],
  "explanation": "Palavras curtas terminadas em e ou a perdem a vogal antes de outra vogal ou de h mudo e ganham um apóstrofo: je ai → j'ai, le ami → l'ami, ce est → c'est, ne est → n'est.",
  "examples": [
   {
    "fr": "C'est moi.",
    "pt": "Sou eu."
   },
   {
    "fr": "J'ai le temps.",
    "pt": "Eu tenho tempo."
   }
  ],
  "practice": [
   {
