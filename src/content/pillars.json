 {
  "id": "p-artigos",
  "title": "Artigos definidos e gênero",
  "trigger": [
   "le"
  ],
  "explanation": "Todo substantivo francês é masculino ou feminino, e o gênero nem sempre bate com o português. le = o, la = a, les = os / as. Antes de vogal ou h mudo, le e la viram l'. Aprenda cada palavra junto com o artigo.",
  "examples": [
   {
    "fr": "le pain",
    "pt": "o pão"
   },
   {
    "fr": "la maison",
    "pt": "a casa"
   },
   {
    "fr": "l'eau",
    "pt": "a água"
   }
  ],
  "practice": [
   {
    "fr": "___ maison",
    "pt": "a casa",
    "answer": "la",
    "options": [
     "le",
     "les",
     "l'"
    ]
   },
   {
    "fr": "___ pain",
    "pt": "o pão",
    "answer": "le",
    "options": [
     "la",
     "les",
     "l'"
    ]
   },
   {
    "fr": "___ gens",
    "pt": "as pessoas",
    "answer": "les",
    "options": [
     "le",
     "la",
     "l'"
    ]
   }
  ]
 },
